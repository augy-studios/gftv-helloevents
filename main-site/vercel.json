{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "cleanUrls": true,
    "trailingSlash": false,
    "regions": [
        "sin1"
    ],
    "functions": {
        "api/cron/cleanup.js": {
            "maxDuration": 60
        },
        "api/cron/notify.js": {
            "maxDuration": 300
        },
        "api/manage/events.js": {
            "maxDuration": 60
        },
        "api/events/page.js": {
            "includeFiles": "event.html"
        },
        "api/me/stickers.js": {
            "maxDuration": 300
        },
        "api/manage/gallery.js": {
            "maxDuration": 60
        },
        "api/me/helloid.js": {
            "maxDuration": 60,
            "memory": 3009,
            "includeFiles": "{node_modules/@vladmandic/human/dist/human.node-wasm.js,node_modules/@vladmandic/human/models/{blazeface,facemesh,faceres,antispoof,liveness}.*,node_modules/@tensorflow/tfjs-backend-wasm/dist/*.wasm,node_modules/@tesseract.js-data/eng/4.0.0_best_int/**,node_modules/tesseract.js-core/**,node_modules/tesseract.js/src/**,node_modules/mrz/lib/**}"
        }
    },
    "crons": [
        {
            "path": "/api/cron/cleanup",
            "schedule": "30 19 * * *"
        },
        {
            "path": "/api/cron/notify",
            "schedule": "*/10 * * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/e/:slug([a-z0-9-]{3,60})",
            "destination": "/api/events/page?slug=:slug"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https://*.googletagmanager.com https://*.google-analytics.com https://*.g.doubleclick.net https://www.google.com; connect-src 'self' https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com; font-src 'self'; frame-src https://challenges.cloudflare.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
                },
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache"
                }
            ]
        },
        {
            "source": "/(login|account|manage|signup|reset|checkin|helloid)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex"
                }
            ]
        }
    ]
}
