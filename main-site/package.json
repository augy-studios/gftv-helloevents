{
  "name": "gftv-helloevents",
  "version": "1.0.0",
  "private": true,
  "description": "GFTV HelloEvents at events.globalfurry.tv: CE furmeets and furry conventions. Static frontend with no build step, plus Vercel serverless functions under api/.",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.1.1",
    "@supabase/supabase-js": "^2.45.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@upstash/redis": "^1.40.0",
    "@vercel/functions": "^2.2.13",
    "@vladmandic/human": "3.3.6",
    "bcryptjs": "^2.4.3",
    "htmlparser2": "^9.1.0",
    "mrz": "5.0.2",
    "sharp": "^0.34.5",
    "tesseract.js": "7.0.0",
    "web-push": "^3.6.7"
  },
  "scripts": {
    "check-i18n": "node assets/i18n/check-keys.js --scan",
    "check-sw": "node scripts/check-sw.js",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.15.0",
    "globals": "17.13.0"
  },
  "allowScripts": {
    "sharp": true,
    "tesseract.js": false
  }
}
