# GFTV HelloEvents, Vercel environment variables.
# Set these in Vercel > Project > Settings > Environment Variables (Production,
# and Preview if you deploy previews). Names only here: never commit a
# filled-in copy of this file.

# The public origin. Every state-changing request must come from it, and the
# site's own name in Telegram messages comes from it.
SITE_URL=https://events.globalfurry.tv

# Supabase > Project Settings > API. The same project as gftvhello_users.
# The service role key bypasses RLS, so it lives here only and never in
# browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=

# 32 random bytes, as 64 hex characters or 44 base64 characters. Encrypts the
# authenticator secrets people set up on this site. Make one with:
#   openssl rand -hex 32
# Changing it later makes every authenticator set up here unreadable (those
# people then sign in with a backup code, a passkey or Telegram, and set the
# app up again). Use a new value, not the one OneLink GFTV uses.
TOTP_ENCRYPTION_KEY=

# Any long random string. Salts the hashed IP addresses kept for rate limits
# and the audit log, so the hashes cannot be reversed with a lookup table.
IP_HASH_SALT=

# Vercel Cron sends this as "Authorization: Bearer <value>" to
# /api/cron/cleanup. Any long random string.
CRON_SECRET=

# Passkeys (optional overrides). Blank means the hostname and origin of
# SITE_URL, which is right for events.globalfurry.tv. Only change these
# before anyone has registered a passkey: every passkey is bound to the RP ID
# it was made with and stops working if it changes.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Telegram sign-in codes (optional). Leave all three blank to switch Telegram
# off; the sign-in page then shows no Telegram option. Create a NEW bot with
# @BotFather for this site: a bot has one webhook, and the OneLink GFTV bot's
# already points at links.gftv.asia.
TELEGRAM_BOT_TOKEN=
# The bot's username without the @, for the t.me deep links.
TELEGRAM_BOT_USERNAME=
# 1 to 256 characters from A-Z, a-z, 0-9, _ and -. Passed to setWebhook as
# secret_token; see README.md.
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare Turnstile (optional), the "are you a person" check on the
# sign-in form. The site key is public and shown to the page; the secret key
# stays here. With either one blank nothing is checked; set both together.
# In Cloudflare, add events.globalfurry.tv to the widget's hostnames.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
