# GFTV HelloEvents, Vercel environment variables.
# Set these in Vercel > Project > Settings > Environment Variables (Production,
# and Preview if you deploy previews). Names only here: never commit a
# filled-in copy of this file.

# The public origin. Every state-changing request must come from it, and the
# site's own name in Telegram messages comes from it.
SITE_URL=https://events.globalfurry.tv

# Supabase > Project Settings > API. The same project as gftvhello_users.
# The service role key bypasses RLS, so it lives here only and never in
# browser code. Cover pictures are served from this project's Storage
# (bucket gftvevents_covers, migrations/002), at SUPABASE_URL.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=

# 32 random bytes, as 64 hex characters or 44 base64 characters. Encrypts the
# authenticator secrets set up on this site (public accounts, and staff who
# add one here). Make one with:
#   openssl rand -hex 32
# Changing it later makes every authenticator set up here unreadable (those
# people then sign in with a backup code, a passkey or Telegram, and set the
# app up again). Use a new value, not the one OneLink GFTV uses.
TOTP_ENCRYPTION_KEY=

# Any long random string. Salts the hashed IP addresses kept for rate limits
# and the audit log, so the hashes cannot be reversed with a lookup table.
IP_HASH_SALT=

# Vercel Cron sends this as "Authorization: Bearer <value>" to
# /api/cron/cleanup. Any long random string.
CRON_SECRET=

# Passkeys (optional overrides). Blank means the hostname and origin of
# SITE_URL, which is right for events.globalfurry.tv. Only change these
# before anyone has registered a passkey: every passkey is bound to the RP ID
# it was made with and stops working if it changes.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Telegram sign-in codes (optional). Leave all three blank to switch Telegram
# off; the sign-in page then shows no Telegram option. Create a NEW bot with
# @BotFather for this site: a bot has one webhook, and the OneLink GFTV bot's
# already points at links.gftv.asia.
TELEGRAM_BOT_TOKEN=
# The bot's username without the @, for the t.me deep links.
TELEGRAM_BOT_USERNAME=
# 1 to 256 characters from A-Z, a-z, 0-9, _ and -. Passed to setWebhook as
# secret_token; see README.md.
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare Turnstile, the "are you a person" check on sign-in, sign-up and
# starting a password reset (api/_lib/turnstile.js). The HelloEvents widget
# already exists in Cloudflare; its site key is public and built in
# (0x4AAAAAAFoBqV14BTwQSjRX), so only the secret has to be set here.
# In Cloudflare, the widget's hostnames must include events.globalfurry.tv.
#
# The widget's secret key, from Cloudflare > Turnstile > the widget. Mark it
# Sensitive in Vercel. Without it, production refuses those forms (fail
# closed, "the check is not working on our side"); local and preview deploys
# skip the check and show no widget. TURNSTILE_SECRET_KEY, the name
# gftv-linktree uses, is read too if this one is blank.
TURNSTILE_SECRET=
# The hostnames a token may come from, comma-separated. Blank means SITE_URL's
# hostname. Production: events.globalfurry.tv (localhost and 127.0.0.1 are
# ignored in production whatever is set here). A Preview deploy with a secret
# needs its own *.vercel.app hostname here, and on the widget's list.
TURNSTILE_HOSTNAMES=events.globalfurry.tv
# Optional: a different site key. Blank means the built-in one above. For
# local work, leave TURNSTILE_SECRET blank instead: the check is then skipped
# and no widget is shown (outside production only).
TURNSTILE_SITE_KEY=

# Web Push notifications (optional). Leave blank to switch browser
# notifications off; the account page then says so. Make a key pair once:
#   npx web-push generate-vapid-keys
# The public key is handed to browsers; the private key stays here. Changing
# them later means every device has to turn notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services can contact about this sender: a mailto: address or the
# site address. Blank means https://events.globalfurry.tv.
VAPID_SUBJECT=

# Upstash Redis, for the push subscriptions. Add it to the Vercel project
# from the Marketplace (Storage > Upstash for Redis, "Connect to project");
# Vercel then sets these two itself. A store moved over from the retired
# Vercel KV has KV_REST_API_URL and KV_REST_API_TOKEN instead, which work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
